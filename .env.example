# =============================================================================
# FormalizeAI v4.1 — Variáveis de Ambiente
# InNovaIdeia | https://github.com/Foxactive1/formalizeAi_v2
# =============================================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env no repositório.
# Adicione .env ao .gitignore se ainda não estiver.
# =============================================================================


# -----------------------------------------------------------------------------
# 🔑 GROQ API — OBRIGATÓRIO
# Obtenha sua chave em: https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_SUBSTITUA_PELA_SUA_CHAVE_GROQ

# Modelo padrão para geração de SDD.
# Opções disponíveis (em ordem de capacidade):
#   llama-3.3-70b-versatile  ← recomendado para produção (melhor qualidade)
#   mixtral-8x7b-32768
#   llama-3.1-8b-instant     ← mais rápido, menor custo
#   gemma2-9b-it
DEFAULT_MODEL=llama-3.3-70b-versatile


# -----------------------------------------------------------------------------
# 🔐 AUTENTICAÇÃO — Recomendado em produção
# -----------------------------------------------------------------------------
# Chave secreta para assinar tokens JWT.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES

# API Key para autenticação de serviços externos (opcional).
# Se definida, todas as rotas protegidas exigem o header: X-Api-Key: <valor>
# Deixe vazio para desabilitar a autenticação por API Key.
X_API_KEY=


# -----------------------------------------------------------------------------
# 🗄️ SUPABASE — Opcional (fallback: armazenamento local em /tmp)
# Obtenha em: https://supabase.com → Settings → API
# Sem Supabase, os dados são perdidos a cada restart em produção.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...SUA_ANON_KEY_AQUI


# -----------------------------------------------------------------------------
# ⚡ REDIS — Opcional (fallback: cache em memória local)
# Necessário para: cache persistente entre instâncias e rate limiting robusto.
# Formatos aceitos:
#   redis://localhost:6379
#   redis://:senha@host:6379/0
#   rediss://host:6379  (TLS)
# -----------------------------------------------------------------------------
REDIS_URL=


# -----------------------------------------------------------------------------
# 📂 ARMAZENAMENTO DE PROJETOS — Opcional
# Diretório para salvar projetos SDD localmente (fallback do Supabase).
# Padrão: /tmp/formalizeai_projects (Railway) ou ./formalizeai_projects (local)
# Em Railway: dados em /tmp são apagados a cada deploy — use Supabase.
# -----------------------------------------------------------------------------
PROJECTS_DIR=


# -----------------------------------------------------------------------------
# 🚦 RATE LIMITING
# Controla quantas requisições por IP/API Key são permitidas por janela de tempo.
# -----------------------------------------------------------------------------
# Número máximo de requisições permitidas na janela de tempo
RATE_LIMIT_REQUESTS=60

# Janela de tempo em segundos (padrão: 60s = 1 minuto)
RATE_LIMIT_PERIOD=60


# -----------------------------------------------------------------------------
# 🤖 ORQUESTRAÇÃO DE AGENTES
# -----------------------------------------------------------------------------
# Número máximo de ciclos de geração/validação do Orchestrator.
# Aumentar melhora a qualidade mas eleva o consumo de tokens.
MAX_ORCHESTRATION_CYCLES=3

# Score mínimo (0–18) para o SDD ser aprovado automaticamente.
# Abaixo desse valor, o Orchestrator tenta regenerar (até MAX_ORCHESTRATION_CYCLES).
QUALITY_THRESHOLD=12


# -----------------------------------------------------------------------------
# 💬 HISTÓRICO E MENSAGENS
# -----------------------------------------------------------------------------
# Número máximo de caracteres por mensagem do usuário
MAX_MESSAGE_LENGTH=5000

# Número máximo de mensagens mantidas no histórico de contexto
MAX_HISTORY_LENGTH=20


# -----------------------------------------------------------------------------
# ⏱️ CACHE
# -----------------------------------------------------------------------------
# Tempo de vida do cache em segundos (padrão: 5 minutos)
CACHE_TTL=300

# Número máximo de itens no cache em memória (ignorado se Redis estiver ativo)
CACHE_MAX_ITEMS=100


# -----------------------------------------------------------------------------
# 🌐 FLASK — Ambiente de execução
# -----------------------------------------------------------------------------
# Use "development" para ativar debug mode e reloader automático
# Use "production" para deploy (nunca use debug em produção!)
FLASK_ENV=production

# Porta de execução (Railway injeta PORT automaticamente)
PORT=5000


# =============================================================================
# 📋 CHECKLIST DE CONFIGURAÇÃO
#
# Desenvolvimento local:
#   [x] GROQ_API_KEY          — obrigatório
#   [ ] SECRET_KEY            — recomendado (usa padrão inseguro se omitido)
#   [ ] SUPABASE_URL/KEY      — opcional (dados salvos localmente)
#   [ ] REDIS_URL             — opcional (cache em memória)
#
# Produção (Railway):
#   [x] GROQ_API_KEY          — obrigatório
#   [x] SECRET_KEY            — obrigatório (gere um valor forte)
#   [x] SUPABASE_URL/KEY      — obrigatório (evitar perda de dados em /tmp)
#   [x] REDIS_URL             — recomendado (rate limit e cache persistentes)
#   [x] X_API_KEY             — recomendado (proteger endpoints de produção)
# =============================================================================
